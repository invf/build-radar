# ─── BuildRadar Environment Variables ─────────────────────────────────────────
# Copy this to .env.local (frontend) and .env (backend) and fill in values

# ─── Frontend (Next.js / Vercel) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Backend (FastAPI / Render) ───────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production

# Database (Supabase PostgreSQL — use Session mode pooler URL from Supabase dashboard)
DATABASE_URL=postgresql+asyncpg://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Redis (Upstash or Render Redis)
REDIS_URL=redis://default:password@your-redis-host:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-jwt-secret-min-32-chars

# CORS
CORS_ORIGINS=["https://your-app.vercel.app"]

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-key
EMAIL_FROM=noreply@buildradar.ua

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@o123.ingest.sentry.io/456
